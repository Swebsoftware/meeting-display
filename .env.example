# Copy to .dev.vars for Wrangler local development. Never prefix secrets with VITE_.
DEMO_MODE=true
DISPLAY_TIME_ZONE=America/New_York
# Production: set DEMO_MODE=false in wrangler.jsonc and configure secrets.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TARGET_USER_ID=

# Delegated Microsoft connection (HTTPS callback required for live OAuth):
AUTH_MODE=delegated
APP_ORIGIN=https://meeting-display.falling-sea-3e49.workers.dev
TOKEN_ENCRYPTION_KEY=
# CONNECTIONS is a Wrangler KV binding, not a process variable.
